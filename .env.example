# ----------------------------------------------------
# ESLA KIDS ENVIRONMENT VARIABLES EXAMPLE
# ----------------------------------------------------

# Database (PostgreSQL via Neon / Prisma)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key"

# App Public URL
NEXT_PUBLIC_APP_URL="https://eslakids.com"

# Meta (Facebook) Pixel & Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
# META_TEST_EVENT_CODE="" # Facebook Events Manager > Test Events tab code (e.g. TEST12345)

# PayTR (Payment Gateway)
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Stocado Integration
STOCADO_API_KEY=""
STOCADO_API_SECRET=""
